From 4334b0afd75d32ff178d1ff2292efcb87d29cbda Mon Sep 17 00:00:00 2001
From: retropineaple <118107729+retropineaple@users.noreply.github.com>
Date: Tue, 27 Oct 2026 21:08:41 +0530
Subject: [PATCH 35/47] Display13 eDP backlight: 'bklt' 0 clears
 BACKLIGHT_ENABLE (panel off) instead of the floor level

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 WhateverXe/kern_xe.cpp      | 16 ++++++++++++++++
 tools/decode_panel_trace.py |  2 +-
 2 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/WhateverXe/kern_xe.cpp b/WhateverXe/kern_xe.cpp
index 7b9ed2c..e44f4e1 100644
--- a/WhateverXe/kern_xe.cpp
+++ b/WhateverXe/kern_xe.cpp
@@ -7288,11 +7288,27 @@ uint32_t XE::display13PanelSetBrightness(IOService *fb,uint32_t value) {
   if(!count || count>16)return kIOReturnUnsupported;
   bits=count;
  }
+ // 'bklt' 0 is "panel off" (lid closed with sleep disabled, display dim to
+ // off, lowest key step), as on Apple panels: clear BACKLIGHT_ENABLE
+ // (0x720 bit 0) instead of leaving the OLED lit at the floor level.
+ static bool off;
+ if(!value && s->panelBrightnessDPCD) {
+  uint8_t control=uint8_t(block[0]&~1U);
+  r=off ? 0 : wrapDisplay13WriteAUX(port,0x720,&control,1);
+  if(!r)off=true;
+  display13PanelTrace(34,value,0,r,(uint64_t(bits)<<8)|2|s->panelBrightnessDPCD);
+  return r;
+ }
  const uint32_t max=(1U<<bits)-1,floor=max/128 ? max/128 : 1;
  uint32_t level=uint32_t((uint64_t(value>0xFFFF ? 0xFFFF : value)*max+0x7FFF)/0xFFFF);
  if(level<floor)level=floor; // DPCD 0 turns the OLED fully dark.
  uint8_t bytes[2]={uint8_t(level>>8),uint8_t(level)};
  r=wrapDisplay13WriteAUX(port,0x722,bytes,2);
+ if(!r && off) {
+  uint8_t control=uint8_t(block[0]|1U);
+  r=wrapDisplay13WriteAUX(port,0x720,&control,1);
+  if(!r)off=false;
+ }
  if(!r && !s->panelBrightnessDPCD) {
   // Level first, then DPCD control (0x721 bits 1:0 = 2) and AUX enable (0x720 bit 0).
   uint8_t mode=uint8_t((block[1]&~3U)|2U),control=uint8_t(block[0]|1U);
diff --git a/tools/decode_panel_trace.py b/tools/decode_panel_trace.py
index abf190d..48a2cfa 100644
--- a/tools/decode_panel_trace.py
+++ b/tools/decode_panel_trace.py
@@ -49,7 +49,7 @@ def describe(ev, a, b, c, d, e):
     if ev == 33:
         return "described native mode %#x (donor res %x, call %d)" % (a, b, c)
     if ev == 34:
-        return "bklt %#x -> DPCD %#x res=%x bits=%d dpcdMode=%d" % (a, b, c, d >> 8, d & 1)
+        return "bklt %#x -> DPCD %#x res=%x bits=%d dpcdMode=%d%s" % (a, b, c, d >> 8, d & 1, " PANEL-OFF" if d & 2 else "")
     if ev == 4:
         return "ddi=%d res=%x mode=%d conn=%d %s" % (a, b, c, d, link(e))
     if ev == 11:
