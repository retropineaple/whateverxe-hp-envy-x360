From dc747524905ff60125f26096436b1e6fe970714f Mon Sep 17 00:00:00 2001
From: retropineaple <118107729+retropineaple@users.noreply.github.com>
Date: Tue, 27 Oct 2026 13:52:47 +0530
Subject: [PATCH 14/54] Report the running link rate in LINK_BW_SET for the eDP
 panel

The OLED is an eDP 1.4 sink trained through LINK_RATE_SET and returns
0x01 in LINK_BW_SET. AppleGraphicsDevicePolicy derives DP link bandwidth
from 0x100, asserts linkBW and rejects every mode. When a port A DPCD
read covers 0x100 with an invalid code, report the adopted link's rate.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 WhateverXe/kern_xe.cpp      | 14 ++++++++++++++
 tools/decode_panel_trace.py |  4 +++-
 2 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/WhateverXe/kern_xe.cpp b/WhateverXe/kern_xe.cpp
index 590e050..d523b21 100644
--- a/WhateverXe/kern_xe.cpp
+++ b/WhateverXe/kern_xe.cpp
@@ -7193,6 +7193,20 @@ uint32_t XE::wrapDisplay13ReadAUX(void *port,uint32_t address,void *data,uint32_
  if(!ready)return kIOReturnNotReady;
  const auto r=FunctionCast(wrapDisplay13ReadAUX,callbackXE->orgDisplay13ReadAUX)(port,address,data,length);
  IOLockLock(c.lock);const bool complete=display13AUXReady(port,false);IOLockUnlock(c.lock);
+ // -wex-adlp-edp: an eDP 1.4 panel trained through LINK_RATE_SET (0x115)
+ // need not report a valid LINK_BW_SET (0x100); this OLED returns 0x01.
+ // AGDP derives link bandwidth from 0x100 and then rejects every mode.
+ // Report the rate the adopted link actually runs at (HBR here).
+ if(!r && complete && callbackXE->display13PanelDP && data && length && address<=0x100 && address+length>0x100 &&
+    Display13FBMemory::field<uint32_t>(port,0x120)==0) {
+  auto &bw=static_cast<uint8_t *>(data)[0x100-address];
+  if(bw!=0x06 && bw!=0x0A && bw!=0x14 && bw!=0x1E) {
+   const auto rate=Display13FBMemory::field<uint32_t>(port,0x128);
+   const uint8_t actual=rate==6?0x06:rate==10?0x0A:rate==20?0x14:rate==30?0x1E:0x0A;
+   display13PanelTrace(26,address,length,bw,actual,rate);
+   bw=actual;
+  }
+ }
  return r ? r : complete ? 0 : kIOReturnNotReady;
 }
 uint32_t XE::wrapDisplay13WriteAUX(void *port,uint32_t address,void *data,uint32_t length) {
diff --git a/tools/decode_panel_trace.py b/tools/decode_panel_trace.py
index c306fb6..26162de 100644
--- a/tools/decode_panel_trace.py
+++ b/tools/decode_panel_trace.py
@@ -4,7 +4,7 @@ import re, struct, sys
 
 NAMES = {1: "attr", 4: "probe", 5: "AUXFAIL", 6: "enablePort", 7: "disablePort", 8: "trainPat",
          9: "clkOn", 10: "clkOff", 11: "DDC", 20: "connChg>", 21: "connChg<", 22: "online>",
-         23: "online<", 24: "connProbe", 25: "curMode", 30: "bootAdopt"}
+         23: "online<", 24: "connProbe", 25: "curMode", 26: "linkBW", 30: "bootAdopt"}
 ALL = (1 << 64) - 1
 
 
@@ -34,6 +34,8 @@ def describe(ev, a, b, c, d, e):
             (d >> 24) & 0xff, link(e))
     if ev == 25:
         return "live=%dx%d modes=%d chosen=%x first.pclk=%d first=%dx%d" % (a >> 32, a & 0xffffffff, b, c, d, e >> 32, e & 0xffffffff)
+    if ev == 26:
+        return "dpcd@%x len=%d LINK_BW_SET %#x -> %#x (port rate %d)" % (a, b, c, d, e)
     if ev == 4:
         return "ddi=%d res=%x mode=%d conn=%d %s" % (a, b, c, d, link(e))
     if ev == 11:
